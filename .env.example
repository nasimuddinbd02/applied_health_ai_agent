# ============================================================================
# Provider keys — all model access is routed through LiteLLM.
# The first provider in PROVIDER_PRIORITY that has a key is the PRIMARY model;
# the remaining providers (that have keys) become automatic LiteLLM fallbacks.
# Leave all blank to run fully offline in mock mode.
# ============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Priority chain: primary first, then fallbacks. Default = OpenAI, then
# Anthropic, then Gemini.
PROVIDER_PRIORITY=openai,anthropic,gemini

# --- Per-provider model strings (override any if you have newer models) ---
OPENAI_MODEL_QUALITY=openai/gpt-4o
OPENAI_MODEL_CHEAP=openai/gpt-4o-mini
ANTHROPIC_MODEL_QUALITY=anthropic/claude-opus-4-8
ANTHROPIC_MODEL_CHEAP=anthropic/claude-haiku-4-5-20251001
GEMINI_MODEL_QUALITY=gemini/gemini-1.5-pro
GEMINI_MODEL_CHEAP=gemini/gemini-1.5-flash

# --- MCP tool server (FastMCP SSE transport) ---
MCP_HOST=127.0.0.1
MCP_PORT=8077
MCP_TRANSPORT=sse
# Set MCP_URL only to point at a tool server somewhere else; it overrides
# MCP_HOST/MCP_PORT.
MCP_URL=

# --- Behaviour ---
# Real models are used whenever a provider key is present. Set MOCK_MODE=true to
# force the offline deterministic path even when keys are configured.
MOCK_MODE=false

# --- Database (SQLite file kept under backend/database/) ---
DATABASE_URL=sqlite:///database/hospital.db

# ============================================================================
# Realtime chat gateway (WebSocket) + distributed coordination
# ============================================================================
# Identity of this instance. Leave blank for host-pid; in Kubernetes set it to
# the pod name so logs/metrics/Redis routing all agree.
SERVER_ID=

# Redis: connection metadata, chat sessions, idempotency keys, rate limits, the
# cross-instance pub/sub channel and the event-bus streams.
# Set REDIS_ENABLED=false to run strictly single-instance with in-process
# fallbacks (everything still works; nothing is shared between processes).
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true
REDIS_NAMESPACE=cityhospital

# --- WebSocket transport ---
WS_HEARTBEAT_SECONDS=25
WS_MISSED_HEARTBEATS_ALLOWED=2
WS_MAX_MESSAGE_BYTES=8192
WS_MAX_CONNECTIONS_PER_SESSION=4
WS_REGISTRY_TTL_SECONDS=90

# --- Abuse limits (per chat session) ---
CHAT_RATE_LIMIT_MESSAGES=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Event bus (Redis Streams; swap for Kafka/Event Hubs by implementing
#     app/messaging/event_bus.py:EventBus) ---
EVENT_STREAM_PREFIX=events
EVENT_CONSUMER_GROUP=agent-workers
EVENT_MAX_DELIVERY_ATTEMPTS=3
EVENT_CLAIM_IDLE_MS=60000

# Run the agent worker inside the API process (handy for local dev).
# Set false in production and run `make run-worker` as its own deployment.
INLINE_AGENT_WORKER=true
AGENT_WORKER_CONCURRENCY=4

# --- Conversation state ---
CONVERSATION_CACHE_TTL_SECONDS=3600
CONVERSATION_HISTORY_TURNS=20
IDEMPOTENCY_TTL_SECONDS=86400
GUEST_SESSION_EXPIRE_MINUTES=1440

# --- Auth (JWT; also signs anonymous guest chat sessions) ---
JWT_SECRET=dev-secret-change-me

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
